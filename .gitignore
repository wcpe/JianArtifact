# ===== Go 构建产物 =====
/bin/
apps/server/bin/
*.exe
*.exe~
*.dll
*.so
*.dylib
*.out
*.test

# 依赖与覆盖率
/vendor/
coverage.out
coverage.html

# 本地 Go 模块缓存（仅本机构建用，不入库；见 README 环境说明）
/.gomodcache/
/.gocache/

# ===== Node 构建产物与依赖 =====
node_modules/
dist/
build/
.cache/
*.tsbuildinfo

# Turborepo
.turbo/

# 日志
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ===== 前端内嵌产物（由构建注入 apps/server，不入库；保留占位 index.html 以保证 //go:embed 可编译）=====
# 先重新纳入该目录（覆盖上面全局 dist/ 规则），再忽略其内容，最后放行占位 index.html。
!/apps/server/web/dist/
/apps/server/web/dist/*
!/apps/server/web/dist/index.html

# ===== 运行期数据（不入库）=====
# SQLite 元数据库
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
# blob 存储目录与上传目录
/data/
/var/
/uploads/
# 运行日志
*.log
/logs/

# ===== IDE / 操作系统 =====
/.idea/
.vscode/
*.iml
.DS_Store
Thumbs.db

# ===== 过程性文档与临时文件（不入库）=====
/.tmp/

# ===== 环境与密钥（不入库）=====
.env
.env.local
.env.*.local
deploy/.env
# 远程部署专用 SSH 密钥（deploy/remote-ssh.sh setup-key 生成）
deploy/ssh/
