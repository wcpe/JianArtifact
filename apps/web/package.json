{
  "name": "@jianartifact/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "JianArtifact 管理端（React + Mantine 7 + i18next）。",
  "scripts": {
    "dev": "vite",
    "licenses:gen": "node ../../scripts/generate-licenses.mjs",
    "build": "node ../../scripts/generate-licenses.mjs && tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run --coverage"
  },
  "dependencies": {
    "@jianartifact/ui": "workspace:*",
    "@mantine/charts": "^9.6.1",
    "@mantine/core": "^9.6.1",
    "@mantine/dates": "9.6.1",
    "@mantine/form": "^9.6.1",
    "@mantine/hooks": "^9.6.1",
    "@mantine/modals": "^9.6.1",
    "@mantine/notifications": "^9.6.1",
    "@tabler/icons-react": "^3.30.0",
    "i18next": "^26.4.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-i18next": "^17.0.14",
    "react-router-dom": "^6.30.6",
    "recharts": "^3.2.1"
  },
  "devDependencies": {
    "@jianartifact/devmock": "workspace:*",
    "@jianartifact/eslint-config": "workspace:*",
    "@jianartifact/typescript-config": "workspace:*",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.5.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.1.2",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "^9.13.0",
    "jsdom": "^30.1.0",
    "msw": "2.7.6",
    "postcss": "^8.5.28",
    "postcss-preset-mantine": "^1.17.0",
    "postcss-simple-vars": "^7.0.1",
    "typescript": "^5.6.3",
    "vite": "^7.3.6",
    "vitest": "^4.1.11"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
