{
  "name": "@jianartifact/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "JianArtifact 管理端（React + Mantine 7 + i18next）。",
  "scripts": {
    "dev": "vite",
    "licenses:gen": "node ../../scripts/generate-licenses.mjs",
    "build": "node ../../scripts/generate-licenses.mjs && tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run --coverage"
  },
  "dependencies": {
    "@jianartifact/ui": "workspace:*",
    "@mantine/charts": "^8.3.18",
    "@mantine/core": "^8.3.18",
    "@mantine/dates": "8.3.18",
    "@mantine/form": "^8.3.18",
    "@mantine/hooks": "^8.3.18",
    "@mantine/modals": "^8.3.18",
    "@mantine/notifications": "^8.3.18",
    "@tabler/icons-react": "^3.30.0",
    "i18next": "^26.4.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^17.0.14",
    "react-router-dom": "^6.30.6",
    "recharts": "2.15.4"
  },
  "devDependencies": {
    "@jianartifact/devmock": "workspace:*",
    "@jianartifact/eslint-config": "workspace:*",
    "@jianartifact/typescript-config": "workspace:*",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.0.1",
    "@testing-library/user-event": "^14.5.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^5.1.2",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "^9.13.0",
    "jsdom": "^29.1.1",
    "msw": "2.7.6",
    "postcss": "^8.5.28",
    "postcss-preset-mantine": "^1.17.0",
    "postcss-simple-vars": "^7.0.1",
    "typescript": "^5.6.3",
    "vite": "^7.3.6",
    "vitest": "^4.1.11"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
