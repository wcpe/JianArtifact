# JianArtifact 环境变量模板 —— 复制为 deploy/.env 后填入真实值。
# .env 严禁入库（见 .gitignore）；密钥经此文件 / Secret 注入，不硬编码、不进日志。

# ---- 监听 ----
JIAN_HTTP_ADDR=0.0.0.0
JIAN_HTTP_PORT=8080

# ---- 数据目录（容器内路径；由命名卷挂载持久化）----
JIAN_DATA_DIR=/data
# SQLite 元数据文件路径（默认在数据目录下）
JIAN_DB_PATH=/data/jianartifact.db
# 制品内容 blob 目录
JIAN_BLOB_DIR=/data/blobs
# 可信工作目录根：blob 落盘限制在此根内，拒绝路径逃逸
JIAN_TRUSTED_WORKDIR=/data

# ---- 安全（必填，勿留空、勿用示例值上线）----
# JWT 签名密钥（HS256）：生成高强度随机值，例如 `openssl rand -base64 48`
JIAN_JWT_SECRET=
# 首个管理员不再经环境变量引导：改为启动后经网页自举端点
# `POST /api/v1/auth/bootstrap`（仅未初始化时开放）或 CLI `jianartifact admin reset` 创建。

# ---- 日志 ----
# 级别：debug | info | warn | error
JIAN_LOG_LEVEL=info

# ---- proxy 上游凭据（可选）----
# 以“引用名 -> 环境变量”的方式注入 Authorization，不落配置文件明文。
# 例：某上游引用名为 maven-central，则设置 JIAN_UPSTREAM_CRED_MAVEN_CENTRAL 为实际令牌值
# JIAN_UPSTREAM_CRED_EXAMPLE=
