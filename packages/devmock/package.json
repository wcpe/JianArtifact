{
  "name": "@jianartifact/devmock",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "浏览器 + Node 双端 Mock 与场景包；据 api/openapi.yaml 做契约比对。",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "gen": "openapi-typescript ../../api/openapi.yaml -o src/schema.gen.ts",
    "build": "pnpm run gen && tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "yaml": "^2.6.0"
  },
  "devDependencies": {
    "@jianartifact/eslint-config": "workspace:*",
    "@jianartifact/typescript-config": "workspace:*",
    "@types/node": "^22.8.1",
    "eslint": "^9.13.0",
    "openapi-typescript": "^7.4.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  }
}
